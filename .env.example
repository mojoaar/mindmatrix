# Database
DATABASE_URL=postgres://mindmatrix:CHANGE_ME_DB_PASSWORD@localhost:5434/mindmatrix
DB_MAX_CONNECTIONS=10

# Auth
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_here_please
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_password
EMAIL_FROM=noreply@mindmatrix.local

# Encryption (32+ characters, used for plugin credentials at rest)
ENCRYPTION_KEY=generate_a_random_32_character_encryption_key_here

# CORS (comma-separated origins e.g. "https://app.example.com,https://docs.example.com")
# Defaults to NEXT_PUBLIC_APP_URL if unset, falling back to http://localhost:3000
ALLOWED_ORIGINS=*
